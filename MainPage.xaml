<Page
    x:Class="LightningChartUnoExample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#131413" />
        <SolidColorBrush x:Key="Surface" Color="#1E201E" />
        <SolidColorBrush x:Key="BorderColor" Color="#3D433D" />
        <SolidColorBrush x:Key="Muted" Color="#A7B5A7" />
        <SolidColorBrush x:Key="AltitudeColor" Color="#8BF584" />
        <SolidColorBrush x:Key="SpeedColor" Color="#FFC56A" />
        <SolidColorBrush x:Key="ClimbColor" Color="#BBA6F2" />
        <SolidColorBrush x:Key="CameraValueColor" Color="#CBD3CB" />
        <SolidColorBrush x:Key="ErrorColor" Color="#FFA996" />
        <Style x:Key="MetricTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="88" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CoordinateLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="CoordinateValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource AltitudeColor}" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderThickness" Value="1,3,1,1" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions> 
        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="_recordingName"
                Text="DRONE FLIGHT  / TELEMETRY"
                FontSize="23"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="_elapsed"
                Grid.Column="1"
                Text="00:00 / 02:05"
                FontSize="18"
                Foreground="{StaticResource Muted}"
                VerticalAlignment="Center" />
            <Button
                x:Name="_playButton"
                Grid.Column="2"
                Content="Pause"
                IsEnabled="False"
                Background="{StaticResource AltitudeColor}"
                Foreground="{StaticResource PageBackground}"
                FontSize="20"
                FontWeight="SemiBold"
                MinWidth="100"
                MinHeight="52" />
        </Grid>
        <TextBlock
            x:Name="_error"
            Grid.Row="1"
            Visibility="Collapsed"
            Foreground="{StaticResource ErrorColor}"
            FontSize="16"
            TextWrapping="Wrap" />
        <!-- Telemetry WebView -->
        <Border
            Grid.Row="2"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            Padding="10,6,10,4">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="LIVE TELEMETRY" FontSize="14" Foreground="{StaticResource Muted}" />
                <WebView2 x:Name="_webView" Grid.Row="1" />
            </Grid>
        </Border>
        <!-- Route and instruments -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- GPS panel -->
            <Border
                Grid.Column="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GPS TRACK" FontSize="18" Foreground="{StaticResource Muted}" />
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Route WebView-->
                        <WebView2 x:Name="_routeWebView" />
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="LATITUDE"
                                        Style="{StaticResource CoordinateLabel}" />
                                    <TextBlock
                                        x:Name="_latitude"
                                        Text="—"
                                        Style="{StaticResource CoordinateValue}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="LONGITUDE"
                                        Style="{StaticResource CoordinateLabel}" />
                                    <TextBlock
                                        x:Name="_longitude"
                                        Text="—"
                                        Style="{StaticResource CoordinateValue}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="DISTANCE"
                                        Style="{StaticResource CoordinateLabel}" />
                                    <TextBlock
                                        x:Name="_distance"
                                        Text="—"
                                        Style="{StaticResource CoordinateValue}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock Text="CAMERA METADATA" FontSize="14" Foreground="{StaticResource Muted}" />
                                <TextBlock
                                    x:Name="_cameraMetadata"
                                    Text="—"
                                    FontSize="12"
                                    Foreground="{StaticResource CameraValueColor}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <!-- Altitude -->
            <Border
                Grid.Column="1"
                Style="{StaticResource MetricCard}"
                BorderBrush="{StaticResource AltitudeColor}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RELATIVE ALTITUDE" Style="{StaticResource MetricTitle}" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox
                                Stretch="Uniform"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="0,8,0,8">
                                <TextBlock
                                    x:Name="_altitude"
                                    Text="—"
                                    Style="{StaticResource MetricValue}"
                                    Foreground="{StaticResource AltitudeColor}" />
                            </Viewbox>
                            <TextBlock
                                Grid.Row="1"
                                Text="m"
                                Style="{StaticResource MetricUnit}" />
                        </Grid>
                        <Grid x:Name="_altitudeGaugeHost" Grid.Column="1" />
                    </Grid>
                </Grid>
            </Border>
            <!-- Horizontal speed -->
            <Border
                Grid.Column="2"
                Style="{StaticResource MetricCard}"
                BorderBrush="{StaticResource SpeedColor}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="HORIZONTAL SPEED" Style="{StaticResource MetricTitle}" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0,8,0,8">
                            <TextBlock
                                x:Name="_speed"
                                Text="—"
                                Style="{StaticResource MetricValue}"
                                Foreground="{StaticResource SpeedColor}" />
                        </Viewbox>
                        <TextBlock
                            Grid.Row="1"
                            Text="km/h"
                            Style="{StaticResource MetricUnit}" />
                    </Grid>
                </Grid>
            </Border>
            <!-- Vertical speed -->
            <Border
                Grid.Column="3"
                Style="{StaticResource MetricCard}"
                BorderBrush="{StaticResource ClimbColor}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="VERTICAL SPEED" 
                        Style="{StaticResource MetricTitle}" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Viewbox
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0,8,0,8">

                            <TextBlock
                                x:Name="_climb"
                                Text="—"
                                Style="{StaticResource MetricValue}"
                                Foreground="{StaticResource ClimbColor}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="m/s"
                            Style="{StaticResource MetricUnit}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>